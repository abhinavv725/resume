---
const socials = [
  { href: 'https://www.linkedin.com/in/abhinavv725/', icon: 'fab fa-linkedin-in', label: 'LinkedIn' },
  { href: 'https://github.com/abhinavv725',           icon: 'fab fa-github',      label: 'GitHub' },
  { href: 'mailto:abhinavv1701@gmail.com',            icon: 'fas fa-envelope',    label: 'Email' },
  { href: 'https://leetcode.com/u/abhinav_725/',      icon: 'fas fa-code',        label: 'LeetCode' },
  { href: 'https://www.goodreads.com/abhinavv725',    icon: 'fab fa-goodreads-g', label: 'Goodreads' },
];
---

<section id="about" class="min-h-screen flex flex-col justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 pt-16 px-6 relative overflow-hidden">

  <!-- Subtle background grid -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"></div>

  <!-- Accent blob -->
  <div class="absolute top-1/4 right-0 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 left-0 w-80 h-80 bg-sky-400/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto w-full py-20 relative">
    <div class="flex flex-col lg:flex-row lg:items-center gap-10">

      <!-- Photo -->
      <div class="flex-shrink-0">
        <div class="relative w-32 h-32 sm:w-40 sm:h-40">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-sky-400 to-sky-600 blur-lg opacity-30 scale-110"></div>
          <img src="/assets/img/profile.jpg" alt="Abhinav Verma"
               class="relative w-full h-full rounded-2xl object-cover border border-white/10" />
        </div>
      </div>

      <!-- Text -->
      <div class="flex-1">
        <p class="text-sky-400 text-sm font-semibold uppercase tracking-widest mb-3">Cloud Platform Engineer 2</p>
        <h1 class="font-condensed text-6xl sm:text-7xl lg:text-8xl font-bold text-white uppercase tracking-wide leading-none mb-4">
          Abhinav<br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-sky-200">Verma</span>
        </h1>

        <p class="text-slate-400 text-lg leading-relaxed max-w-2xl mb-8">
          4 years at FICO building AWS infrastructure, Kubernetes platforms, and CI/CD automation at scale.
          <span class="text-slate-300">4× AWS certified.</span> 1250+ DSA problems.
          Bengaluru, India.
        </p>

        <!-- Socials -->
        <div class="flex flex-wrap gap-3">
          {socials.map(({ href, icon, label }) => (
            <a href={href} target={href.startsWith('mailto') ? undefined : '_blank'}
               class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:bg-white/10 hover:border-sky-400/50 transition-all text-sm font-medium">
              <i class={icon}></i>
              <span class="hidden sm:inline">{label}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600 animate-bounce">
    <i class="fas fa-chevron-down text-sm"></i>
  </div>
</section>
