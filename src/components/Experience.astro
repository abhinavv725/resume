---
import { experience } from '../data/experience';
---
<section id="experience" class="resume-section">
  <div class="resume-section-content">
    <h2 class="section-heading">Experience</h2>

    <div class="space-y-6">
      {experience.map((role) => (
        <div class="group bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 hover:border-sky-200 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
            <div>
              <h3 class="text-xl font-bold text-slate-900">{role.title}</h3>
              <p class="text-sky-600 font-medium mt-0.5">{role.company} · {role.location}</p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-slate-50 border border-slate-200 text-slate-500 text-xs font-medium whitespace-nowrap self-start">
              {role.period}
            </span>
          </div>

          <ul class="space-y-2.5 mb-5">
            {role.bullets.map((bullet) => (
              <li class="flex gap-3 text-slate-600 text-sm leading-relaxed">
                <span class="mt-2 flex-shrink-0 w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                <span set:html={bullet} />
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
            {role.stack.map((tech) => (
              <span class="px-2.5 py-1 bg-slate-50 border border-slate-200 text-slate-600 text-xs rounded-lg font-medium group-hover:border-sky-100 group-hover:bg-sky-50/50 transition-colors">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
